   "source": [
    "class Solution:\n",
    "    def isPalindrome(self, x: int) -> bool:\n",
    "        if x < 0:\n",
    "            return False\n",
    "        else:\n",
    "            s = str(x)\n",
    "            rev = s[::-1]\n",
    "            if rev == s:\n",
    "                return True\n",
    "            else: \n",
    "                return False"
   ]
  }
